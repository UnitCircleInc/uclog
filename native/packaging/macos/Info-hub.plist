<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded in the uclog-hub executable (__TEXT,__info_plist: crates/uclog-hub/build.rs); uclog has Info.plist.
     CoreBluetooth needs NSBluetoothAlwaysUsageDescription even for command-line tools. -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>ca.unitcircle.uclog-hub</string>
  <key>CFBundleName</key>
  <string>uclog-hub</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>uclog connects to ucLog devices over Bluetooth Low Energy.</string>
</dict>
</plist>
